# Rust build output
/target
**/*.rs.bk

# Compose files emitted by `mesh gen-compose` are derived from a scenario; keep
# the scenarios in git and regenerate the compose rather than committing it.
docker-compose.generated.yml
docker-compose.*.generated.yml

# The seeded experiment is deterministic (seed 42), so results/ is committed and
# matches the tagged release. `make reproduce` regenerates the same numbers.
# The raw csv, the summary, and analysis_summary.md are the authoritative
# reproducible artifacts; the figures are regenerated from them.

# Raw local mesh run logs. The captured trial runs that the report cites live in
# results/*.log instead, so the noisy per-run logs stay out of git.
/logs/

# Timestamped per-run captures from the Crane Cloud real-Internet trials. The
# authoritative captured run is committed as results/production_crane_cloud_*.
/results/realnet_edge_validate_*.log
/results/realnet_cloud_status_validate_*.csv
/results/realnet_linktrace_*

# Python
__pycache__/
*.pyc
.venv/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# LaTeX build artifacts (manuscript compiles locally for verification)
paper/overleaf/*.aux
paper/overleaf/*.log
paper/overleaf/*.out
paper/overleaf/*.fls
paper/overleaf/*.fdb_latexmk
paper/overleaf/*.synctex.gz
